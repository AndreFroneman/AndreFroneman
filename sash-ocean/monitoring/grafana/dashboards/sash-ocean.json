    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(sash_sensor_online)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Rate-limited requests (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(increase(sash_rate_limited_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API latency p50 / p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "histogram_quantile(0.5, sum(rate(sash_http_request_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "histogram_quantile(0.95, sum(rate(sash_http_request_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API requests / s by status",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(rate(sash_http_request_duration_seconds_count[5m])) by (status)",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Ingestion rate (observations / min)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(rate(sash_ingested_observations_total[5m])) by (kind) * 60",
     "legendFormat": "{{kind}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(rate(sash_ingest_rejected_total[5m])) by (reason) * 60",
     "legendFormat": "rejected: {{reason}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Alerts generated (per hour)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "sum(increase(sash_alerts_generated_total[1h])) by (alert_type)",
     "legendFormat": "{{alert_type}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Analytics run duration (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "rate(sash_analytics_run_seconds_sum[30m]) / rate(sash_analytics_run_seconds_count[30m])",
     "legendFormat": "mean",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Data source health",
   "datasource": {
    "type": "prometheus",
