     },
     "expr": "sash_sensor_online",
     "legendFormat": "{{sensor}} ({{sensor_type}})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Authentication failures / h",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
