{
 "uid": "sash-ocean-ops",
 "title": "SASH Ocean \u2014 Platform Operations",
 "tags": [
  "sash"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Database up",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "sash-prom"
     },
     "expr": "max(sash_database_up)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Active vessels (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
