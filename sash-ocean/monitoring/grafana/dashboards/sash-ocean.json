     },
     "expr": "sash_data_source_healthy",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Sensor health",
   "datasource": {
    "type": "prometheus",
    "uid": "sash-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
