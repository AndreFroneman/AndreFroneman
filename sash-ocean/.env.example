# SASH Ocean configuration. Copy to .env and replace EVERY placeholder, or run
# ./scripts/init-env.sh which generates strong random values. Never commit .env.

SASH_ENV=development
POSTGRES_USER=sash
POSTGRES_DB=sash
POSTGRES_PASSWORD=change-me-postgres-password
SASH_JWT_SECRET=change-me-to-a-random-string-of-at-least-48-characters
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Demo mode: synthetic demonstration world, simulated live AIS feed.
SASH_DEMO_MODE=true
SASH_DEMO_LIVE_FEED=true
SASH_DEMO_ADMIN_PASSWORD=change-me-Admin-1
SASH_DEMO_ANALYST_PASSWORD=change-me-Analyst-1
SASH_DEMO_CUSTOMER_PASSWORD=change-me-Customer-1

# Ports
SASH_HTTP_PORT=8080
SASH_HTTPS_PORT=8443
SASH_TLS_CN=localhost
SASH_FORCE_HTTPS=false

# Optional live data connectors (all disabled unless configured).
AIS_API_KEY=
SASH_CONNECTOR_NGA_ASAM=false
SASH_CONNECTOR_OFAC_SDN=false
SASH_CONNECTOR_OPEN_METEO=false
OPEN_METEO_API_KEY=
SASH_ALERT_WEBHOOK_URL=
